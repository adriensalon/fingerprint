include_guard(GLOBAL)

file(SHA256 "${INPUT1}" hash1)
file(SHA256 "${INPUT2}" hash2)
if(hash1 STREQUAL hash2)
    set(identical true)
else()
    set(identical false)
endif()
function(_fingerprint_sha256_quote value out_string)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${out_string} "\"${value}\"" PARENT_SCOPE)
endfunction()

set(_inputs "{}")
foreach(_index IN ITEMS 1 2)
    get_filename_component(_filename "${INPUT${_index}}" NAME)
    _fingerprint_sha256_quote("${_filename}" _filename)
    file(SIZE "${INPUT${_index}}" _size)
    set(_target "null")
    if(DEFINED INPUT${_index}_TARGET AND NOT INPUT${_index}_TARGET STREQUAL "")
        _fingerprint_sha256_quote("${INPUT${_index}_TARGET}" _target)
    endif()
    string(JSON _input SET "{}" filename "${_filename}")
    string(JSON _input SET "${_input}" target "${_target}")
    string(JSON _input SET "${_input}" size_bytes "${_size}")
    string(JSON _input SET "${_input}" sha256 "\"${hash${_index}}\"")
    string(JSON _inputs SET "${_inputs}" input${_index} "${_input}")
endforeach()
set(_configuration "null")
if(DEFINED BUILD_CONFIG AND NOT BUILD_CONFIG STREQUAL "")
    _fingerprint_sha256_quote("${BUILD_CONFIG}" _configuration)
endif()
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" _report)
else()
    set(_report "{}")
endif()
string(JSON _tools ERROR_VARIABLE _json_error GET "${_report}" tools)
if(_json_error)
    set(_tools "{}")
endif()
string(JSON _result SET "{}" identical "${identical}")
string(JSON _tools SET "${_tools}" sha256 "${_result}")
string(JSON _report SET "{}" schema_version 1)
string(JSON _report SET "${_report}" configuration "${_configuration}")
string(JSON _report SET "${_report}" inputs "${_inputs}")
string(JSON _report SET "${_report}" tools "${_tools}")
file(WRITE "${OUTPUT}" "${_report}\n")
