include_guard(GLOBAL)

if(NOT CMAKE_SCRIPT_MODE_FILE)
    set(FINGERPRINT_CAPA_ROOT "${CMAKE_BINARY_DIR}/_deps/capa")
    find_program(FINGERPRINT_CAPA_EXECUTABLE
        NAMES capa
        NO_CMAKE_FIND_ROOT_PATH)
    if(NOT FINGERPRINT_CAPA_EXECUTABLE AND CMAKE_HOST_WIN32)
        set(_fingerprint_capa_archive "${FINGERPRINT_CAPA_ROOT}/capa-v10.0.0-windows.zip")
        set(_fingerprint_capa_executable "${FINGERPRINT_CAPA_ROOT}/bin/capa.exe")
        if(NOT EXISTS "${_fingerprint_capa_executable}")
            file(MAKE_DIRECTORY "${FINGERPRINT_CAPA_ROOT}")
            message(STATUS "[fingerprint] Downloading capa")
            file(DOWNLOAD
                "https://github.com/mandiant/capa/releases/download/v10.0.0/capa-v10.0.0-windows.zip"
                "${_fingerprint_capa_archive}"
                EXPECTED_HASH SHA256=8712991044321dbb2a5b0d60f7a5327a50c9c30a295e7ddb5c1088cb17fb59df
                TLS_VERIFY ON
                STATUS _fingerprint_capa_download_status)
            list(GET _fingerprint_capa_download_status 0 _fingerprint_capa_download_code)
            if(NOT _fingerprint_capa_download_code EQUAL 0)
                message(FATAL_ERROR "Failed to download capa: ${_fingerprint_capa_download_status}")
            endif()
            message(STATUS "[fingerprint] Extracting capa")
            file(ARCHIVE_EXTRACT
                INPUT "${_fingerprint_capa_archive}"
                DESTINATION "${FINGERPRINT_CAPA_ROOT}/bin")
            message(STATUS "[fingerprint] capa ready")
        endif()
        set(FINGERPRINT_CAPA_EXECUTABLE "${_fingerprint_capa_executable}"
            CACHE FILEPATH "Path to the standalone capa executable" FORCE)
    endif()
    if(NOT FINGERPRINT_CAPA_EXECUTABLE OR NOT EXISTS "${FINGERPRINT_CAPA_EXECUTABLE}")
        message(FATAL_ERROR "capa was not found. Install the standalone release or set FINGERPRINT_CAPA_EXECUTABLE to its executable path.")
    endif()
    add_executable(fingerprint_capa IMPORTED GLOBAL)
    set_target_properties(fingerprint_capa PROPERTIES
        IMPORTED_LOCATION "${FINGERPRINT_CAPA_EXECUTABLE}")
    add_custom_target(fingerprint_capa_build DEPENDS "${FINGERPRINT_CAPA_EXECUTABLE}")
    return()
endif()

find_program(FINGERPRINT_CAPA_EXECUTABLE
    NAMES capa
    NO_CMAKE_FIND_ROOT_PATH)
if(NOT FINGERPRINT_CAPA_EXECUTABLE OR NOT EXISTS "${FINGERPRINT_CAPA_EXECUTABLE}")
    message(FATAL_ERROR "capa executable was not found at: ${FINGERPRINT_CAPA_EXECUTABLE}")
endif()
foreach(_input IN ITEMS INPUT1 INPUT2)
    if(NOT EXISTS "${${_input}}" OR IS_DIRECTORY "${${_input}}")
        message(FATAL_ERROR "capa input file does not exist: ${${_input}}")
    endif()
endforeach()
if(NOT DEFINED OUTPUT OR OUTPUT STREQUAL "")
    message(FATAL_ERROR "OUTPUT is required for the capa comparison report")
endif()

function(_fingerprint_capa_analyze input out_result)
    get_filename_component(input "${input}" REALPATH)
    get_filename_component(name "${input}" NAME)
    file(SHA256 "${input}" input_hash)
    string(SHA256 key "${_capa_hash}|${input}|${input_hash}")
    get_filename_component(directory "${OUTPUT}" DIRECTORY ABSOLUTE)
    set(cache "${directory}/.capa/${key}.json")
    file(MAKE_DIRECTORY "${directory}/.capa")
    file(LOCK "${cache}.lock" GUARD FUNCTION TIMEOUT 1 RESULT_VARIABLE lock_status)
    if(NOT lock_status STREQUAL "0")
        message(STATUS "[fingerprint] capa: waiting for analysis of ${name}")
        file(LOCK "${cache}.lock" GUARD FUNCTION TIMEOUT 300 RESULT_VARIABLE lock_status)
    endif()
    if(NOT lock_status STREQUAL "0")
        message(FATAL_ERROR "Failed to lock capa analysis cache for ${input}: ${lock_status}")
    endif()
    if(EXISTS "${cache}")
        file(READ "${cache}" analysis)
        string(JSON rules_type ERROR_VARIABLE json_error TYPE "${analysis}" rules)
    endif()
    if(NOT rules_type STREQUAL "OBJECT" OR json_error)
        cmake_path(NATIVE_PATH input NORMALIZE native_input)
        message(STATUS "[fingerprint] capa: analyzing ${name}")
        execute_process(
            COMMAND "${FINGERPRINT_CAPA_EXECUTABLE}" --json --quiet -- "${native_input}"
            RESULT_VARIABLE status
            OUTPUT_VARIABLE analysis
            ERROR_VARIABLE error
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_STRIP_TRAILING_WHITESPACE
            TIMEOUT 300)
        if(NOT status STREQUAL "0")
            message(FATAL_ERROR "capa analysis failed for ${input}: ${error}\n${analysis}")
        endif()
        string(JSON rules_type ERROR_VARIABLE json_error TYPE "${analysis}" rules)
        if(json_error OR NOT rules_type STREQUAL "OBJECT")
            message(FATAL_ERROR "capa did not return a JSON object containing rules for ${input}: ${json_error}")
        endif()
        file(WRITE "${cache}.tmp" "${analysis}\n")
        file(RENAME "${cache}.tmp" "${cache}")
        message(STATUS "[fingerprint] capa: analysis ready for ${name}")
    endif()
    set(${out_result} "${analysis}" PARENT_SCOPE)
endfunction()

function(_fingerprint_capa_capabilities analysis out_capabilities)
    set(capabilities)
    string(JSON count LENGTH "${analysis}" rules)
    if(count GREATER 0)
        math(EXPR last_index "${count} - 1")
        foreach(index RANGE 0 ${last_index})
            string(JSON rule MEMBER "${analysis}" rules ${index})
            string(JSON library ERROR_VARIABLE json_error GET "${analysis}" rules "${rule}" meta lib)
            if(NOT json_error AND library)
                continue()
            endif()
            string(JSON subscope ERROR_VARIABLE json_error GET "${analysis}" rules "${rule}" meta is_subscope_rule)
            if(NOT json_error AND subscope)
                continue()
            endif()
            list(APPEND capabilities "${rule}")
        endforeach()
    endif()
    list(SORT capabilities)
    set(${out_capabilities} "${capabilities}" PARENT_SCOPE)
endfunction()

function(_fingerprint_capa_quote value out_string)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${out_string} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(_fingerprint_capa_array out_array)
    set(array "[]")
    set(index 0)
    foreach(value IN LISTS ARGN)
        _fingerprint_capa_quote("${value}" quoted)
        string(JSON array SET "${array}" ${index} "${quoted}")
        math(EXPR index "${index} + 1")
    endforeach()
    set(${out_array} "${array}" PARENT_SCOPE)
endfunction()

file(SHA256 "${FINGERPRINT_CAPA_EXECUTABLE}" _capa_hash)
_fingerprint_capa_analyze("${INPUT1}" _analysis1)
_fingerprint_capa_analyze("${INPUT2}" _analysis2)
_fingerprint_capa_capabilities("${_analysis1}" _capabilities1)
_fingerprint_capa_capabilities("${_analysis2}" _capabilities2)
set(_capabilities ${_capabilities1} ${_capabilities2})
list(REMOVE_DUPLICATES _capabilities)
list(SORT _capabilities)
string(JSON _version ERROR_VARIABLE _json_error GET "${_analysis1}" meta version)
if(_json_error)
    set(_version "null")
else()
    _fingerprint_capa_quote("${_version}" _version)
endif()
string(JSON _result SET "{}" version "${_version}")
string(JSON _result SET "${_result}" capabilities "{}")
foreach(_capability IN LISTS _capabilities)
    set(_matches "{}")
    set(_source "")
    foreach(_index IN ITEMS 1 2)
        list(FIND _capabilities${_index} "${_capability}" _found)
        set(_count 0)
        if(NOT _found EQUAL -1)
            string(JSON _count ERROR_VARIABLE _json_error LENGTH "${_analysis${_index}}" rules "${_capability}" matches)
            if(_json_error OR _count LESS 1)
                message(FATAL_ERROR "capa rule '${_capability}' has no valid matches for input${_index}")
            endif()
            if(_source STREQUAL "")
                set(_source "${_analysis${_index}}")
            endif()
        endif()
        string(JSON _matches SET "${_matches}" input${_index} "${_count}")
    endforeach()
    string(JSON _namespace_type ERROR_VARIABLE _json_error TYPE "${_source}" rules "${_capability}" meta namespace)
    set(_namespace "null")
    if(NOT _json_error AND _namespace_type STREQUAL "STRING")
        string(JSON _namespace GET "${_source}" rules "${_capability}" meta namespace)
        _fingerprint_capa_quote("${_namespace}" _namespace)
    endif()
    string(JSON _entry SET "{}" namespace "${_namespace}")
    string(JSON _entry SET "${_entry}" matches "${_matches}")
    foreach(_kind IN ITEMS attack mbc)
        set(_ids)
        string(JSON _count ERROR_VARIABLE _json_error LENGTH "${_source}" rules "${_capability}" meta ${_kind})
        if(NOT _json_error AND _count GREATER 0)
            math(EXPR _last_index "${_count} - 1")
            foreach(_index RANGE 0 ${_last_index})
                string(JSON _id GET "${_source}" rules "${_capability}" meta ${_kind} ${_index} id)
                list(APPEND _ids "${_id}")
            endforeach()
        endif()
        list(REMOVE_DUPLICATES _ids)
        list(SORT _ids)
        _fingerprint_capa_array(_ids_json ${_ids})
        string(JSON _entry SET "${_entry}" ${_kind} "${_ids_json}")
    endforeach()
    string(JSON _result SET "${_result}" capabilities "${_capability}" "${_entry}")
endforeach()
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" _report)
else()
    set(_report "{\"tools\":{}}")
endif()
string(JSON _report SET "${_report}" tools capa "${_result}")
file(WRITE "${OUTPUT}" "${_report}\n")
